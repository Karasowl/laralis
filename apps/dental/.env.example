# =============================================================================
# Laralis / apps/dental — Plantilla de variables de entorno
# =============================================================================
# Copia este archivo a `.env.local` y rellena los valores.
#   cp apps/dental/.env.example apps/dental/.env.local
#
# IMPORTANTE: `.env.local`, `.env.production.local`, `.env.qa.local` y
# `cypress.env.json` están en .gitignore — NO viajan con el repo. Para
# recrearlos en otra PC, ver SETUP-NUEVA-PC.md en la raíz del repo.
#
# Atajo recomendado (proyecto vinculado a Vercel):
#   vercel env pull apps/dental/.env.local --environment=development
# =============================================================================


# -----------------------------------------------------------------------------
# 1) Convex — BACKEND DE DATOS ACTUAL (source of truth)
# -----------------------------------------------------------------------------
# Estas son las variables MÍNIMAS para correr el dev server hoy. Apuntan a un
# deployment de Convex en la nube; copiarlas conecta a ESE mismo backend (no
# hace falta re-deployar Convex). Obtenlas desde el dashboard de Convex o con
# `npx convex dev` la primera vez.
CONVEX_DEPLOYMENT=dev:your-deployment-name            # ej. dev:happy-animal-123
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
CONVEX_AUTH_BRIDGE_SECRET=generate_a_long_random_secret   # secreto compartido Next<->Convex
CONVEX_AUTH_SESSION_SECRET=generate_a_long_random_secret  # firma de sesión del bridge

# Flags de backend de datos (controlan si lee/escribe en Convex o Supabase).
# Estado actual del proyecto: Convex es la fuente de verdad.
AUTH_BACKEND=convex
NEXT_PUBLIC_AUTH_BACKEND=convex
DATA_READ_BACKEND=convex
DATA_WRITE_MODE=convex
# Overrides por dominio (opcional): DATA_READ_BACKEND_<DOMAIN>, DATA_WRITE_MODE_<DOMAIN>
#   ej. DATA_READ_BACKEND_SNAPSHOTS=convex, DATA_WRITE_MODE_EXPENSES=convex
# CONVEX_STORAGE_MIRROR_STRICT=1   # hace fatales los fallos de lectura de storage en Convex

# Lado del deployment de Convex (NO se setean aquí; usar `npx convex env set`).
# Ver runbook: docs/IMPORTANT/CONVEX-AUTH-CUTOVER-RUNBOOK.md
#   JWT_PRIVATE_KEY, JWKS, SITE_URL        (genera `npx @convex-dev/auth`)
#   AUTH_RESEND_KEY=<resend api key>       (ResendOTP corre DENTRO de Convex)
#   AUTH_EMAIL="Laralis <noreply@laralis.com>"


# -----------------------------------------------------------------------------
# 2) Supabase — legacy / auth dual / tests
# -----------------------------------------------------------------------------
# Aún se usa para auth dual y para los tests E2E/QA. Valores desde el dashboard:
# https://supabase.com/dashboard/projects
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here   # SERVER-ONLY, nunca al cliente


# -----------------------------------------------------------------------------
# 3) Configuración de la app
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.2.0
TOTP_ENCRYPTION_KEY=generate_a_64_character_random_secret
CRON_SECRET=generate_a_random_secret      # protege los endpoints de cron (/api/cron/*)


# -----------------------------------------------------------------------------
# 4) IA (Lara) — STT / LLM / TTS
# -----------------------------------------------------------------------------
# Providers: STT=deepgram|whisper  LLM=kimi|openai|deepseek  TTS=deepgram|fishaudio|openai
AI_STT_PROVIDER=deepgram
AI_LLM_PROVIDER=kimi
AI_TTS_PROVIDER=deepgram                  # usa la misma API key de Deepgram que STT

DEEPGRAM_API_KEY=your_deepgram_api_key_here   # requerido para STT y TTS (si deepgram en ambos)
KIMI_API_KEY=your_kimi_api_key_here

# Providers alternativos (descomenta si los usas)
# FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

AI_LLM_MODEL=kimi-k2-thinking             # K2 Thinking (default; más lento, mejor razonamiento)
# AI_LLM_MODEL=moonshot-v1-32k            # alternativa más rápida
AI_DEFAULT_LANGUAGE=es
AI_LLM_TEMPERATURE=0.3
AI_RATE_LIMITING_ENABLED=true
AI_RATE_LIMIT_PER_HOUR=100


# -----------------------------------------------------------------------------
# 5) Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Laralis


# -----------------------------------------------------------------------------
# 6) WhatsApp (Twilio)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+10000000000


# -----------------------------------------------------------------------------
# 7) Google Calendar (OAuth)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback


# -----------------------------------------------------------------------------
# 8) Push Notifications (Web Push API / VAPID)
# -----------------------------------------------------------------------------
# Genera las llaves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
