# Supabase Configuration
# Get these values from your Supabase project dashboard
# https://supabase.com/dashboard/projects
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Provider webhooks
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here

# Development Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.2.0
TOTP_ENCRYPTION_KEY=generate_a_64_character_random_secret

# AI Configuration
# Select providers: deepgram|whisper, kimi|openai|deepseek, deepgram|fishaudio|openai
AI_STT_PROVIDER=deepgram
AI_LLM_PROVIDER=kimi
AI_TTS_PROVIDER=deepgram    # Recommended: Uses same Deepgram API key as STT

# AI API Keys (get one based on your provider selection)
DEEPGRAM_API_KEY=your_deepgram_api_key_here    # Required for STT and TTS (if using deepgram for both)
KIMI_API_KEY=your_kimi_api_key_here

# Alternative providers (uncomment if using different providers)
# FISH_AUDIO_API_KEY=your_fish_audio_api_key_here    # Optional: Alternative TTS
# OPENAI_API_KEY=your_openai_api_key_here            # Optional: Fallback for STT, LLM, TTS
# DEEPSEEK_API_KEY=your_deepseek_api_key_here        # Optional: Budget LLM

# AI Configuration (optional)
AI_LLM_MODEL=kimi-k2-thinking    # Use K2 Thinking for better reasoning (default, slower but more accurate)
# AI_LLM_MODEL=moonshot-v1-32k   # Alternative: faster but less reasoning power
AI_DEFAULT_LANGUAGE=es
AI_LLM_TEMPERATURE=0.3
AI_RATE_LIMITING_ENABLED=true
AI_RATE_LIMIT_PER_HOUR=100

# Push Notifications Configuration (Web Push API)
# Generate VAPID keys with: npx web-push generate-vapid-keys
# Public key is used in the browser, private key is for server-side push delivery
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
# VAPID_PRIVATE_KEY=your_vapid_private_key_here  # TODO: Uncomment when web-push library is installed

# ----------------------------------------------------------------------------
# Convex backend (migration off Supabase) — Next.js side
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud   # Convex deployment URL
# CONVEX_AUTH_BRIDGE_SECRET=...                              # shared secret for Convex mutations/sensitive queries
#
# Data backend flags (default 'supabase'; flip per-domain after parity is verified):
#   DATA_BACKEND[_<DOMAIN>], DATA_READ_BACKEND[_<DOMAIN>], DATA_WRITE_MODE[_<DOMAIN>]
#   e.g. DATA_READ_BACKEND_SNAPSHOTS=convex, DATA_WRITE_MODE_EXPENSES=convex,
#        DATA_READ_BACKEND_STORAGE=convex, DATA_READ_BACKEND_CLINICS=convex
#   CONVEX_STORAGE_MIRROR_STRICT=1   # make Convex storage read failures fatal (default: fall back to Supabase)

# ----------------------------------------------------------------------------
# Convex Auth (@convex-dev/auth) — email/password only. CUTOVER IS OPERATOR-GATED.
# ----------------------------------------------------------------------------
# Next.js side (set BOTH for the client + server flag readers to agree):
#   AUTH_BACKEND=convex
#   NEXT_PUBLIC_AUTH_BACKEND=convex
#
# Convex deployment side — set with `npx convex env set`, NOT here (see the cutover
# runbook: docs/IMPORTANT/CONVEX-AUTH-CUTOVER-RUNBOOK.md). Generated by `npx @convex-dev/auth`:
#   JWT_PRIVATE_KEY, JWKS, SITE_URL
# Resend (ResendOTP runs INSIDE Convex; separate from the Next.js RESEND_API_KEY):
#   AUTH_RESEND_KEY=<resend api key>
#   AUTH_EMAIL="Laralis <noreply@laralis.com>"
